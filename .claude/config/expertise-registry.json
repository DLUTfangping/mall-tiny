{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Expertise registry for agent capabilities",
  "version": "1.0.0",

  "categories": {
    "engineering": {
      "title": "Engineering",
      "description": "Software development expertise",
      "roles": ["senior-frontend-engineer", "senior-backend-engineer", "terminal-app-developer"]
    },
    "product": {
      "title": "Product",
      "description": "Product management and strategy",
      "roles": ["product-manager"]
    },
    "architecture": {
      "title": "Architecture",
      "description": "System design and architecture",
      "roles": ["solution-architect"]
    },
    "quality": {
      "title": "Quality",
      "description": "Testing and quality assurance",
      "roles": ["qa-engineer"]
    },
    "operations": {
      "title": "Operations",
      "description": "DevOps and infrastructure",
      "roles": ["devops-engineer"]
    },
    "specialized": {
      "title": "Specialized",
      "description": "Domain-specific expertise",
      "roles": []
    }
  },

  "experience_levels": [
    {
      "id": "junior",
      "label": "Junior (3-5 years)",
      "years": "3-5",
      "description": "Solid fundamentals, learning patterns",
      "autonomy": "medium",
      "mentoring": false
    },
    {
      "id": "senior",
      "label": "Senior (10+ years)",
      "years": "10+",
      "description": "Deep expertise, best practices",
      "autonomy": "high",
      "mentoring": true
